# Environment: .env.example is checked in, real values never are.
.env
.env.local
.env.*.local
# The repo root ignores `.env*` wholesale, which swallows the example too. A
# negation in this deeper file wins, so the template stays tracked without
# anyone needing to remember `git add -f`.
!.env.example

