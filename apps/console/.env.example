# The CURRENT Neon branch's auth base URL. Get it from `neon env pull` at the repo
# root -- every branch has its OWN auth environment, so a literal here is correct
# for exactly one branch and rots on the next.
VITE_NEON_AUTH_URL=

# 127.0.0.1, never localhost: uvicorn binds IPv4 only and Windows resolves
# localhost to ::1 first (208ms wasted per request, invisible server-side).
VITE_API_BASE_URL=http://127.0.0.1:8000
