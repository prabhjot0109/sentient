# The CURRENT Neon branch's auth base URL. Get it from `neon env pull` at the repo
# root -- every branch has its OWN auth environment, so a literal here is correct
# for exactly one branch and rots on the next.
VITE_NEON_AUTH_URL=

# 127.0.0.1, never localhost: uvicorn binds IPv4 only and Windows resolves
# localhost to ::1 first (208ms wasted per request, invisible server-side).
#
# NOTE the opposite rule for this app's OWN origin: browse the console at
# http://localhost:5175, NOT http://127.0.0.1:5175. Neon Auth rejects the IP
# literal with INVALID_ORIGIN and every sign-up fails. See AGENTS.md.
VITE_API_BASE_URL=http://127.0.0.1:8000

# --- Google sign-in -----------------------------------------------------------
# There is NO variable for it, and that is the whole point of this block.
#
# The Google button is turned on in code (`social={{ providers: ["google"] }}`
# in features/auth/components/AuthUIShell.tsx) and turned on in Neon per BRANCH.
# The OAuth client id and secret live on Neon's side, never in this file and
# never in the bundle -- a public SPA cannot hold a client secret.
#
# Check which providers a branch has:
#   neon neon-auth oauth-provider list --branch <branch>
#
# Enable Google on a branch using Neon's SHARED OAuth app (no Google Cloud
# project needed, ~5 seconds, DEV ONLY -- the consent screen shows Neon's
# branding, and Neon says not to ship it):
#   neon neon-auth oauth-provider add --provider-id google --branch <branch>
#
# For PRODUCTION, create your own client at
# https://console.cloud.google.com/apis/credentials (OAuth client ID -> Web
# application), set its authorised redirect URI to the callback Neon prints, then:
#   neon neon-auth oauth-provider add --provider-id google --branch <branch> \
#     --oauth-client-id <id> --oauth-client-secret <secret>
#
# A deployed origin ALSO has to be trusted, or the redirect back fails:
#   neon neon-auth domain add <https://your-console-origin> --branch <branch>
