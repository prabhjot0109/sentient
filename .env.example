# You can plug in several provider keys at once — each provider uses its own key.
# e.g. keep GOOGLE_API_KEY for embeddings while LLM_PROVIDER=groq drives the LLM.
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
OPENAI_BASE_URL=
# Optional base-URL overrides (sensible defaults are built in):
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Providers: google | groq | cerebras | openrouter | openai | huggingface | auto
LLM_PROVIDER=auto
# Embeddings stay on Google here. groq/cerebras/openrouter have no embeddings API,
# so if one of them is auto-picked for embeddings it falls back to local HF.
EMBEDDING_PROVIDER=auto
MODEL_NAME=
#gpt-oss-120b
#gemma-4-31b
#openai/gpt-oss-20b
#openai/gpt-oss-120b
#gemini-2.5-flash
#gemini-3.5-flash
# Names a model on the embedding provider it is set for. Groq/Cerebras/OpenRouter
# serve no embeddings, so when one of them is auto-selected for embeddings the
# provider falls back to local HuggingFace and this name is ignored (the HF default
# BAAI/bge-base-en-v1.5 is used instead) — a Google model name cannot load from the
# HuggingFace Hub. Set EMBEDDING_PROVIDER explicitly to pin both.
EMBEDDING_MODEL_NAME=models/gemini-embedding-2

# --- Groq (fast, high limits) -------------------------------------------------
# Set LLM_PROVIDER=groq. Default MODEL_NAME is llama-3.3-70b-versatile (no reasoning).
# For a reasoning model like openai/gpt-oss-120b, turn reasoning down and hide the
# chain-of-thought so NPCs don't speak their thoughts:
#   MODEL_NAME=openai/gpt-oss-120b
#   GROQ_REASONING_EFFORT=low      # low | medium | high (gpt-oss); "none" for qwen3
#   GROQ_REASONING_FORMAT=hidden   # hidden keeps reasoning out of the reply
# Leave both unset for non-reasoning models (Groq 400s if you send them anyway).
GROQ_REASONING_EFFORT=
GROQ_REASONING_FORMAT=
# Optional: path to the Tesseract binary if it is not on PATH (for scanned-PDF OCR)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
RAG_SEARCH_TYPE=similarity
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_MMR_LAMBDA=0.65
# Drop retrieved lore below this relevance score (0..1) on the grounding path.
# 0 = keep everything. Raise (e.g. 0.2) to stop weak matches polluting NPC prompts.
RAG_SCORE_THRESHOLD=0.2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# --- Retrieval backend (Plan 01/02) -------------------------------------------
# faiss (default, local) | qdrant (async hybrid dense+sparse, Plan 02)
# Qdrant Cloud: set VECTOR_BACKEND=qdrant, QDRANT_URL to your cluster URL,
# QDRANT_API_KEY to its key, and QDRANT_PREFER_GRPC=true (lower-latency gRPC).
# RAG_HYBRID=true adds a local BM25 sparse vector so exact keyword matches
# (item/skill/place names) rank alongside dense semantic hits, fused by RRF.
VECTOR_BACKEND=faiss
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=sentient_lore
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_HYBRID=false
# Rewrite pronoun-laden follow-ups into standalone queries before retrieval.
# Off by default: one extra LLM call, gated by a pronoun heuristic (Plan 03).
RAG_CONDENSE_QUERIES=false

# --- Relational state backend (R1) --------------------------------------------
# neon (default when DATABASE_URL set) | supabase | sqlite (local default).
# Neon and Supabase are both Postgres and share one asyncpg store — only the
# connection string differs. No DATABASE_URL => SQLite at ${DATA_DIR}/state.db.
# Schema: db/migrations/0001_runtime_schema.sql
DB_BACKEND=
DATABASE_URL=            # Neon Postgres connection string
SUPABASE_DB_URL=         # Postgres connection string when DB_BACKEND=supabase

# --- Credential vault (R7) ---------------------------------------------------
# Enables user-uploaded provider API keys, encrypted at rest with Fernet.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to disable credential endpoints; provider keys above remain the config floor.
SENTIENT_SECRET_KEY=

# --- Neon Auth & identity (R2) ------------------------------------------------
# Leave NEON_AUTH_JWKS_URL blank to disable auth — local/dev then runs as a
# single "default" user (SQLite/local needs nothing here). Set it to enable
# JWT auth for web clients (Authorization: Bearer <jwt>). Game mods authenticate
# with a sk-sent-… api key in the URL path regardless of these settings.
# JWKS_URL is the Neon Auth {base_url}/.well-known/jwks.json; ISSUER is {base_url}
# (the token's `iss`). This deployment (better_auth) signs with EdDSA.
#   e.g. NEON_AUTH_JWKS_URL=https://ep-muddy-rice-aonp6rxg.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json
#   e.g. NEON_AUTH_ISSUER=https://ep-muddy-rice-aonp6rxg.neonauth.c-2.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=
NEON_AUTH_ISSUER=
NEON_AUTH_ALGORITHMS=EdDSA,RS256

# --- Web origins (R8) ----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser, for deployed
# frontends. Local Vite dev ports are always allowed regardless of this value.
# e.g. CORS_ALLOW_ORIGINS=https://app.example.com,https://sentient.gg
CORS_ALLOW_ORIGINS=
