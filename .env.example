# =============================================================================
# Sentient - example environment. Copy to .env and fill in the blanks.
#
#   cp .env.example .env
#
# THREE RULES for this file, all measured rather than stylistic:
#
#  1. A bare `NAME=` is NOT "use the default". python-dotenv sets it to the
#     empty string, and any var read as `os.getenv(NAME, default)` will then
#     use "" instead of the default. MODEL_NAME, OPENAI_BASE_URL,
#     QDRANT_COLLECTION, RAG_SPARSE_MODEL, DATA_DIR and NEON_AUTH_ALGORITHMS
#     behave this way, and OPENAI_TIMEOUT_SECONDS= raises ValueError at
#     startup. Anything that must be absent is COMMENTED OUT below, never
#     blanked. Provider API keys are the exception - they are truthiness
#     checked, so blank is correct for those.
#  2. These are DEPLOYMENT defaults (qdrant + neon). The CODE defaults in
#     src/sentient/core/config.py are still faiss + sqlite, so a fresh clone
#     with no .env behaves exactly like main. That is a hard constraint - do
#     not "align" it by editing config.py.
#  3. Every knob below is read by core/config.py, the only place in the
#     codebase that reads an env var. Anything not listed here is not read.
# =============================================================================


# =============================================================================
# 1. PROVIDER API KEYS
# =============================================================================
# Several may be set at once - each provider uses its own key. The usual shape
# is Groq for chat (fast, cheap) plus Google for embeddings, because Groq,
# Cerebras and OpenRouter serve no embeddings API at all.
#
# These are the config floor: the key used when a signed-in user has not
# uploaded their own into the credential vault (section 7).

GOOGLE_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# Also accepted as HF_TOKEN. Needed only for HOSTED HuggingFace inference.
# LOCAL embeddings (BAAI/bge-base-en-v1.5) need no token at all.
HUGGINGFACEHUB_API_TOKEN=

# Base-URL overrides. Defaults are built in for cerebras and openrouter.
# OPENAI_BASE_URL has NO default, so a blank line sends "" to the OpenAI
# client - keep it commented unless pointing `openai` at a compatible service.
# OPENAI_BASE_URL=https://api.openai.com/v1
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Seconds before an LLM call is abandoned. NEVER blank this - it is float()d
# with no guard, so an empty value crashes at import.
OPENAI_TIMEOUT_SECONDS=60


# =============================================================================
# 2. CHAT MODEL
# =============================================================================
# google | groq | cerebras | openrouter | openai | huggingface | auto
#   auto = first provider whose key is present, in the order above.
#   groq = recommended: fastest time-to-first-token, which is what an NPC
#          waiting mid-conversation actually needs.
LLM_PROVIDER=groq

# Per-provider default when MODEL_NAME is commented out:
#   google      gemini-2.5-flash
#   groq        llama-3.3-70b-versatile      (no reasoning pass - fastest)
#   openai      gpt-4o-mini
#   cerebras    llama-3.3-70b
#   openrouter  meta-llama/llama-3.3-70b-instruct
#   huggingface Qwen/Qwen2.5-7B-Instruct
#
# LEAVE COMMENTED to get the default. A bare `MODEL_NAME=` sets the model to
# the empty string and the provider rejects the call.
# MODEL_NAME=openai/gpt-oss-20b

# Reasoning controls. GROQ ONLY, and only for reasoning models
# (openai/gpt-oss-*, qwen3). Groq returns 400 if these are sent to a
# non-reasoning model such as llama-3.3-70b-versatile, so they are blank here
# and blank is safe - both are truthiness checked in adapters/llm/models.py.
#   GROQ_REASONING_EFFORT   low | medium | high      ("none" for qwen3)
#   GROQ_REASONING_FORMAT   hidden                   keeps the chain-of-thought
#                                                    out of the spoken reply
GROQ_REASONING_EFFORT=
GROQ_REASONING_FORMAT=


# =============================================================================
# 3. EMBEDDING MODEL  --  PIN THIS. IT IS THE ONE VALUE YOU CANNOT CHANGE LATER
# =============================================================================
# On VECTOR_BACKEND=qdrant the shared collection is created ONCE, at whatever
# dense dimension writes to it first, and never revisited. Every project on the
# deployment then shares that dimension forever. Changing the embedding model
# later means deleting the collection and re-ingesting every document for every
# user. FAISS has no such limit - it rebuilds per scope.
#
# So do NOT leave this on `auto` for a Qdrant deployment. `auto` resolves off
# whichever keys happen to be present, and if it lands on groq/cerebras/
# openrouter - none of which serve embeddings - config.py silently swaps in
# local HuggingFace AND DISCARDS EMBEDDING_MODEL_NAME, because a Google model
# name cannot be loaded from the HF Hub. The swap is correct; the consequence
# is that the dimension your collection is born with depends on which keys
# happened to be set that day.
#
# google | openai | huggingface | auto
#   google       models/gemini-embedding-001   3072 dims, API call, no local
#                                              RAM. RECOMMENDED when hosted:
#                                              keeps torch out of the
#                                              container memory budget.
#   openai       text-embedding-3-small        1536 dims, API call.
#   huggingface  BAAI/bge-base-en-v1.5          768 dims, runs LOCALLY through
#                                              sentence-transformers - free and
#                                              keyless, but downloads ~400 MB
#                                              on first use and needs the RAM.
#                                              Fine on a dev box, an OOM on a
#                                              512 MB instance.
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL_NAME=models/gemini-embedding-001


# =============================================================================
# 4. RETRIEVAL TUNING
# =============================================================================
# similarity | mmr | similarity_score_threshold.
# IGNORED on Qdrant: the hybrid path always runs dense + sparse and fuses with
# RRF, so this and RAG_MMR_LAMBDA only bite on FAISS.
RAG_SEARCH_TYPE=similarity
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_MMR_LAMBDA=0.65

# Relevance floor (0..1) for retrieved lore.
#
# READ BEFORE TUNING. The number means DIFFERENT THINGS per backend:
#   FAISS   a real cosine similarity. 0.2 usefully drops weak matches.
#   QDRANT  an RRF rank-fusion artefact, not a similarity. Measured: pure
#           gibberish scores about 0.5, so any value below 0.5 is inert and
#           0.6 would discard good hits. The knob does nothing here.
# Never tune it against one backend and deploy the other. 0 keeps everything.
RAG_SCORE_THRESHOLD=0.0

RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# Rewrite pronoun-laden follow-ups ("what about him?") into standalone queries
# before retrieval. Costs one extra LLM call, gated behind a pronoun heuristic.
# Off by default because it adds latency to the NPC turn.
RAG_CONDENSE_QUERIES=false


# =============================================================================
# 5. VECTOR BACKEND  --  qdrant
# =============================================================================
# faiss   local files under ${DATA_DIR}/faiss_index. Zero setup, no network, no
#         dimension lock-in. Right for local dev and for a single box with a
#         persistent disk. Dense only.
# qdrant  hybrid dense + sparse BM25 fused by RRF, INT8 quantised, with
#         tenant/project payload filters. Right for anything hosted, because it
#         survives a container that has no disk.
VECTOR_BACKEND=qdrant

# Qdrant Cloud cluster endpoint, e.g.
#   https://<cluster-id>.us-east-1-0.aws.cloud.qdrant.io:6333
# Leave BLANK and the client falls back to http://localhost:6333, which is what
# a local `docker run -p 6333:6333 qdrant/qdrant` serves.
QDRANT_URL=
QDRANT_API_KEY=

# gRPC (port 6334) is lower latency than REST, but the TLS + authenticated gRPC
# path has NOT been verified against Qdrant Cloud in this repo - the isolation
# run used a local server with no API key. Ship on REST first, and flip this
# only after confirming it end to end.
QDRANT_PREFER_GRPC=false

# One shared collection, partitioned by user_key/project_id payload filters.
# Do not blank: read with a default, so "" would become a real collection name.
QDRANT_COLLECTION=sentient_lore
RAG_SPARSE_MODEL=Qdrant/bm25

# INERT KNOB, kept so an existing .env does not break. It is parsed into
# RAGSettings.hybrid and then read by nothing: Qdrant hardcodes
# RetrievalMode.HYBRID and FAISS has no sparse path at all. Setting it true
# does not add hybrid search to FAISS.
RAG_HYBRID=false


# =============================================================================
# 6. RELATIONAL STATE BACKEND  --  neon
# =============================================================================
# Owns users, api_keys, projects, project_configs, documents,
# provider_credentials, chat_threads, chat_messages.
#
# neon | supabase | sqlite. Leave DB_BACKEND blank and it is INFERRED: "neon"
# when DATABASE_URL is set, "sqlite" otherwise. Neon and Supabase are both
# Postgres behind one asyncpg store - only the connection string differs.
DB_BACKEND=

# Neon POOLED connection string, the host containing "-pooler". Use the pooled
# one: the app opens a connection pool per process, and pgbouncer is what stops
# a scale-to-zero branch from exhausting connections.
#   Neon console -> Connect, or `neon connection-string <branch>`.
DATABASE_URL=

# Read only when DB_BACKEND=supabase.
SUPABASE_DB_URL=

# The SQLite path is ${DATA_DIR}/state.db and needs no variable. Migrations in
# migrations/*.sql are applied by PostgresStateStore on first connect - there
# is no separate migrate step to run.


# =============================================================================
# 7. AUTH  --  Neon Auth identity, and the credential vault
# =============================================================================
# SETTING NEON_AUTH_JWKS_URL TURNS AUTHENTICATION ON FOR THE WHOLE API. Every
# route then demands a Bearer JWT, an X-API-Key header, or a sk-sent-... key in
# the path, and answers 401 without one. Leave blank to run single-user against
# the shared `default` tenant. Game mods authenticate with a sk-sent-... key in
# the URL path either way.
#
# Pull both with `neon env pull` at the repo root. Do NOT paste a URL copied
# from elsewhere: every Neon BRANCH gets its own auth environment, so a literal
# value is correct for exactly one branch and rots on the next.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Optional. Unset, the issuer is derived as the ORIGIN of NEON_AUTH_BASE_URL
# (scheme://host, no path). That is MEASURED against a real Neon token rather
# than taken from Better Auth docs, which describe the issuer as the full base
# URL. jwt.decode compares `iss` as an exact string, so setting this to the
# base URL *including* /neondb/auth rejects every valid token. Set it only to
# override a mismatch you have actually observed.
# NEON_AUTH_ISSUER=

# Do not blank: read with a default, and an empty list accepts no algorithm at
# all, which fails every token.
NEON_AUTH_ALGORITHMS=EdDSA,RS256

# --- Credential vault --------------------------------------------------------
# Enables per-user provider keys, Fernet encrypted at rest. Blank disables the
# credential endpoints entirely; the keys in section 1 remain the config floor.
# Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SENTIENT_SECRET_KEY=

# Retired vault keys, comma separated, accepted for DECRYPTION ONLY. New writes
# always use SENTIENT_SECRET_KEY.
#
# Rotating without this DOES NOT ERROR - services/runtime.py swallows the
# decrypt failure by design, which is right for one corrupt row and wrong for a
# whole table, and every user silently falls back to the env key. Three steps,
# no downtime:
#   1. Deploy with SENTIENT_SECRET_KEY=<new> and SENTIENT_SECRET_KEY_OLD=<old>.
#   2. Run `sentient rotate-secret` to re-encrypt every row. It refuses to run
#      when _OLD is unset and names any row it could not read. Exit 0 = safe.
#   3. Deploy again with SENTIENT_SECRET_KEY_OLD removed.
SENTIENT_SECRET_KEY_OLD=


# =============================================================================
# 8. WEB ORIGINS (CORS)
# =============================================================================
# Comma-separated origins allowed to call the API from a browser. Local Vite
# dev ports are always allowed regardless of this value, so this matters only
# for DEPLOYED frontends - the console, and the landing site if it ever calls
# the API.
#   CORS_ALLOW_ORIGINS=https://console.example.com,https://example.com
#
# Get this wrong and the browser reports a network failure with NO status code,
# which is the single hardest error for the console to explain to a user.
CORS_ALLOW_ORIGINS=


# =============================================================================
# 9. LOGGING
# =============================================================================
# LOG_LEVEL is any stdlib level: DEBUG | INFO | WARNING | ERROR.
# LOG_FORMAT=text is the readable console form. json emits one object per line
# carrying user_key/project_id/thread_id on every record, which is what a log
# shipper wants. Anything that is not exactly "json" degrades to text.
LOG_LEVEL=INFO
LOG_FORMAT=text


# =============================================================================
# 10. UPLOAD AND ABUSE CAPS
# =============================================================================
# Per file and per user total, in bytes. The per-file cap is enforced WHILE the
# file streams, so an oversized upload never lands on disk. The per-user total
# is summed from documents.size_bytes across every project that user owns.
# Defaults: 25 MiB and 500 MiB.
UPLOAD_MAX_BYTES=26214400
UPLOAD_USER_QUOTA_BYTES=524288000

# Extracted-CHARACTER cap, a different thing from the byte cap above.
# UPLOAD_MAX_BYTES counts bytes on the wire, so a small compressed PDF that
# expands to enormous text clears it and then costs an embedding call per
# chunk. Counted AFTER OCR, itself an expansion step, and summed ACROSS pages,
# because the realistic bomb is ten thousand ordinary pages rather than one
# huge one. Defaults to 2x UPLOAD_MAX_BYTES so the two move together.
EXTRACT_MAX_CHARS=52428800

# Live (non-revoked) API keys one user may hold. Revoking frees a slot. 0 =
# unlimited. This is also what caps rate-limit BUDGET, because the limiter
# buckets on a key hash - ten keys would otherwise buy ten buckets.
MAX_API_KEYS_PER_USER=25


# =============================================================================
# 11. RATE LIMITS AND TOKEN QUOTA  --  two different things, not substitutes
# =============================================================================
# Both are OFF by default because a fresh clone must behave like main. TURN
# THEM ON FOR ANY DEPLOYMENT REACHABLE BY SOMEONE OTHER THAN YOU: without them
# a public origin is an open proxy on your provider bill.
#
# Buckets are token buckets, refilled continuously, and they live IN PROCESS.
# With N replicas the effective limit is N x the value here - a deliberate
# trade. Identity is the API key hash, or the client host when no key is
# present, so a console user signing in with a JWT buckets by host.
RATE_LIMIT_ENABLED=false

# Both completions shapes and POST /v1/chat. One Mantella session is roughly
# one request per NPC turn, so 30/min is generous for a player at a keyboard
# and useless to someone reselling the endpoint.
RATE_LIMIT_COMPLETIONS_PER_MINUTE=30
# Uploads cost embedding calls per byte, so they get a tighter bucket on top of
# the disk quota above, which bounds total size but not rate.
RATE_LIMIT_UPLOADS_PER_HOUR=60
# Everything else, including POST /v1/keys.
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# A rate limit bounds how OFTEN a caller can ask; only this bounds what they
# can SPEND. Summed from chat_messages.total_tokens across every project the
# user owns, over a ROLLING 30 days - so it recovers on its own and there is no
# reset anyone has to remember. Ingestion embedding calls are bounded by the
# byte quota instead. 0 = unlimited.
TOKEN_QUOTA_PER_MONTH=0


# =============================================================================
# 12. PATHS AND OPTIONAL TOOLS
# =============================================================================
# Root for local state: ${DATA_DIR}/state.db (SQLite) and
# ${DATA_DIR}/faiss_index (FAISS). With the qdrant + neon pairing above it is
# used only as a staging area during ingestion. Do not blank it.
DATA_DIR=data
# Overrides the FAISS index location only. Defaults to ${DATA_DIR}/faiss_index.
# FAISS_INDEX_PATH=data/faiss_index

# Path to the Tesseract binary for OCR of scanned PDFs, if it is not on PATH.
# Commented out on purpose - an empty value is a real, broken path.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
