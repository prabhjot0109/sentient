# You can plug in several provider keys at once — each provider uses its own key.
# e.g. keep GOOGLE_API_KEY for embeddings while LLM_PROVIDER=groq drives the LLM.
GOOGLE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
HUGGINGFACEHUB_API_TOKEN=
OPENAI_BASE_URL=
# Optional base-URL overrides (sensible defaults are built in):
# CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Providers: google | groq | cerebras | openrouter | openai | huggingface | auto
LLM_PROVIDER=auto
# Embeddings stay on Google here. groq/cerebras/openrouter have no embeddings API,
# so if one of them is auto-picked for embeddings it falls back to local HF.
EMBEDDING_PROVIDER=auto
MODEL_NAME=
#gpt-oss-120b
#gemma-4-31b
#openai/gpt-oss-20b
#openai/gpt-oss-120b
#gemini-2.5-flash
#gemini-3.5-flash
# Names a model on the embedding provider it is set for. Groq/Cerebras/OpenRouter
# serve no embeddings, so when one of them is auto-selected for embeddings the
# provider falls back to local HuggingFace and this name is ignored (the HF default
# BAAI/bge-base-en-v1.5 is used instead) — a Google model name cannot load from the
# HuggingFace Hub. Set EMBEDDING_PROVIDER explicitly to pin both.
EMBEDDING_MODEL_NAME=models/gemini-embedding-2

# --- Groq (fast, high limits) -------------------------------------------------
# Set LLM_PROVIDER=groq. Default MODEL_NAME is llama-3.3-70b-versatile (no reasoning).
# For a reasoning model like openai/gpt-oss-120b, turn reasoning down and hide the
# chain-of-thought so NPCs don't speak their thoughts:
#   MODEL_NAME=openai/gpt-oss-120b
#   GROQ_REASONING_EFFORT=low      # low | medium | high (gpt-oss); "none" for qwen3
#   GROQ_REASONING_FORMAT=hidden   # hidden keeps reasoning out of the reply
# Leave both unset for non-reasoning models (Groq 400s if you send them anyway).
GROQ_REASONING_EFFORT=
GROQ_REASONING_FORMAT=
# Optional: path to the Tesseract binary if it is not on PATH (for scanned-PDF OCR)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
RAG_SEARCH_TYPE=similarity
RAG_TOP_K=4
RAG_FETCH_K=12
RAG_MMR_LAMBDA=0.65
# Drop retrieved lore below this relevance score (0..1) on the grounding path.
# 0 = keep everything. Raise (e.g. 0.2) to stop weak matches polluting NPC prompts.
RAG_SCORE_THRESHOLD=0.2
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# --- Retrieval backend (Plan 01/02) -------------------------------------------
# faiss (default, local) | qdrant (async hybrid dense+sparse, Plan 02)
# Qdrant Cloud: set VECTOR_BACKEND=qdrant, QDRANT_URL to your cluster URL,
# QDRANT_API_KEY to its key, and QDRANT_PREFER_GRPC=true (lower-latency gRPC).
# RAG_HYBRID=true adds a local BM25 sparse vector so exact keyword matches
# (item/skill/place names) rank alongside dense semantic hits, fused by RRF.
VECTOR_BACKEND=faiss
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=sentient_lore
RAG_SPARSE_MODEL=Qdrant/bm25
RAG_HYBRID=false
# Rewrite pronoun-laden follow-ups into standalone queries before retrieval.
# Off by default: one extra LLM call, gated by a pronoun heuristic (Plan 03).
RAG_CONDENSE_QUERIES=false

# --- Relational state backend (R1) --------------------------------------------
# neon (default when DATABASE_URL set) | supabase | sqlite (local default).
# Neon and Supabase are both Postgres and share one asyncpg store — only the
# connection string differs. No DATABASE_URL => SQLite at ${DATA_DIR}/state.db.
# Schema: db/migrations/0001_runtime_schema.sql
DB_BACKEND=
DATABASE_URL=            # Neon Postgres connection string
SUPABASE_DB_URL=         # Postgres connection string when DB_BACKEND=supabase

# --- Credential vault (R7) ---------------------------------------------------
# Enables user-uploaded provider API keys, encrypted at rest with Fernet.
# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset to disable credential endpoints; provider keys above remain the config floor.
SENTIENT_SECRET_KEY=

# --- Neon Auth & identity (R2) ------------------------------------------------
# Pull these with `neon env pull`. Do NOT hardcode a URL here: every Neon branch
# gets its own auth environment, so a literal value is correct for exactly one
# branch and rots on the next.
#
#   NEON_AUTH_BASE_URL   written by `neon env pull`
#   NEON_AUTH_JWKS_URL   written by `neon env pull`. SETTING THIS TURNS AUTH ON.
#
# Setting NEON_AUTH_JWKS_URL turns authentication ON for the whole API: every route
# then requires a Bearer JWT, an X-API-Key, or a key in the path, and returns 401
# without one. Leave it blank to run single-user against the shared `default`
# tenant. Game mods authenticate with a sk-sent-... api key in the URL path
# regardless of these settings. See "Which credential each route accepts" in the
# README.
#
# NEON_AUTH_ISSUER is optional. Unset, it is derived as the ORIGIN of
# NEON_AUTH_BASE_URL (scheme://host, no path). That is measured against a real
# token, not assumed: Better Auth documents the issuer as defaulting to the full
# base URL, but Neon's tokens carry the origin alone. Setting this to the base URL
# *including* the /neondb/auth path -- as this file used to instruct -- rejects
# every valid token, because jwt.decode compares `iss` as an exact string.
# Set it explicitly only to override a measured mismatch.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
NEON_AUTH_ALGORITHMS=EdDSA,RS256

# --- Web origins (R8) ----------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser, for deployed
# frontends. Local Vite dev ports are always allowed regardless of this value.
# e.g. CORS_ALLOW_ORIGINS=https://app.example.com,https://sentient.gg
CORS_ALLOW_ORIGINS=

# --- Logging (H5) --------------------------------------------------------------
# LOG_LEVEL is any stdlib level name: DEBUG, INFO, WARNING, ERROR.
# LOG_FORMAT=text is the readable console form. LOG_FORMAT=json emits one JSON
# object per line, with the request's user_key/project_id/thread_id on every
# record, which is what a log shipper wants. Anything other than "json" is text.
LOG_LEVEL=INFO
LOG_FORMAT=text

# --- Upload limits (H6) --------------------------------------------------------
# Per-file cap and per-user total, both in bytes. The per-file cap is enforced
# while the file is being written, so an oversized upload never lands on disk.
# The per-user total is summed from documents.size_bytes across every project the
# user owns. Defaults are 25 MiB and 500 MiB.
UPLOAD_MAX_BYTES=26214400
UPLOAD_USER_QUOTA_BYTES=524288000

# --- Rate limits (D6) ----------------------------------------------------------
# Off by default, because a fresh clone must behave like main. Turn it on for any
# deployment reachable by someone other than you: without it, a public origin is
# an open proxy on your provider bill.
#
# Buckets are token buckets, refilled continuously, and they live IN PROCESS.
# With N replicas the effective limit is N x the value configured here; that is a
# deliberate trade (see README, "Rate limits") and it changes when X5 lands.
#
# Identity is the API key's hash, or the client host when no key is present. A
# console caller signing in with a JWT therefore buckets by host.
RATE_LIMIT_ENABLED=false
# Both completions shapes and POST /v1/chat. One Mantella session is roughly one
# request per NPC turn, so 30/min is generous for a player and useless to someone
# reselling the endpoint.
RATE_LIMIT_COMPLETIONS_PER_MINUTE=30
# Uploads cost embedding calls per byte, so they get a tighter bucket on top of
# H6's per-user disk quota, which bounds total size but not rate.
RATE_LIMIT_UPLOADS_PER_HOUR=60
# Everything else, including POST /v1/keys.
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# --- Token quota (D6) ----------------------------------------------------------
# 0 = unlimited, and that is the default. A rate limit bounds how OFTEN a caller
# can ask; only this bounds what they can SPEND, and the two are not substitutes.
#
# Counted from chat_messages.total_tokens (H4), summed over every project the user
# owns, across a ROLLING 30 days -- so it recovers on its own and there is no
# reset anybody has to remember to run. It counts only turns Sentient recorded:
# embedding calls during ingestion are bounded by UPLOAD_USER_QUOTA_BYTES instead.
TOKEN_QUOTA_PER_MONTH=0

# --- Rotating the vault key (D8) -----------------------------------------------
# Retired SENTIENT_SECRET_KEY values, comma-separated, still accepted for
# DECRYPTION only. New writes always use SENTIENT_SECRET_KEY.
#
# Changing SENTIENT_SECRET_KEY without this does not error -- it silently stops
# every stored credential from decrypting, and each user's chats quietly fall
# back to the env key. Three steps, no downtime:
#
#   1. Deploy with SENTIENT_SECRET_KEY=<new> and SENTIENT_SECRET_KEY_OLD=<old>.
#   2. Run `sentient rotate-secret` to re-encrypt every row under the new key.
#      It refuses to run if SENTIENT_SECRET_KEY_OLD is unset, and it names any
#      row it could not read. Exit 0 = safe to continue.
#   3. Deploy again with SENTIENT_SECRET_KEY_OLD removed.
#
# Skip them and every stored credential becomes undecryptable; users must
# re-enter their provider keys by hand.
SENTIENT_SECRET_KEY_OLD=

# --- Abuse caps (S6) -----------------------------------------------------------
# Extracted-character cap. UPLOAD_MAX_BYTES counts bytes on the WIRE, so a small
# compressed PDF that expands to enormous text clears it and then costs an
# embedding call per chunk. This bounds that amplification, counted after OCR
# (which is itself an expansion step). Defaults to 2x UPLOAD_MAX_BYTES, so the
# two move together and nothing a fresh clone accepts today is rejected.
EXTRACT_MAX_CHARS=52428800
# Live (non-revoked) API keys one user may hold. POST /v1/keys had no ceiling at
# all; the rate limiter bounds how FAST keys are minted, not how many exist -- and
# since it buckets on a key's hash, capping keys is what caps budgets. 0 =
# unlimited. Revoking frees a slot.
MAX_API_KEYS_PER_USER=25
